{
  "name": "@katren/vue-business-app",
  "version": "0.1.8",
  "description": "Shared Vue infrastructure and reusable features for Katren business applications",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./user": {
      "types": "./src/user/index.ts",
      "import": "./src/user/index.ts"
    },
    "./menu": {
      "types": "./src/menu/index.ts",
      "import": "./src/menu/index.ts"
    },
    "./object-history": {
      "types": "./src/object-history/index.ts",
      "import": "./src/object-history/index.ts"
    },
    "./application-routes": {
      "types": "./src/application-routes/index.ts",
      "import": "./src/application-routes/index.ts"
    },
    "./prog-about": {
      "types": "./src/prog-about/index.ts",
      "import": "./src/prog-about/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build"
  },
  "peerDependencies": {
    "@katren/vue-collection-lib": ">=0.1.7",
    "primeicons": ">=7.0.0",
    "primevue": ">=4.0.0",
    "valibot": ">=1.0.0",
    "vue": ">=3.5.0",
    "vue-i18n": ">=11.0.0",
    "vue-router": ">=4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^21.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "private": false
}
